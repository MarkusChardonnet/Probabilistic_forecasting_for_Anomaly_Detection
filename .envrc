# Activate the uv-managed virtual environment (create it with `uv sync`, see README).
if [[ -d .venv ]]; then
    export VIRTUAL_ENV="$(expand_path .venv)"
    PATH_add .venv/bin
else
    log_error ".venv not found: run 'uv sync --locked --python 3.12' first."
    watch_file .venv/bin/python
fi

# Machine-specific settings belong in the gitignored .envrc.local.
source_env_if_exists .envrc.local
